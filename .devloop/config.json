{
  "version": "1.0",
  "project": {
    "name": "devloop",
    "path": "/home/moncef/code/devloop",
    "tech_stack": "Go 1.21+",
    "main_branch": "main",
    "task_id_prefix": "DEV",
    "task_id_format": "jira"
  },
  "verification": {
    "command": "go test ./... \u0026\u0026 go build ./cmd/devloop",
    "timeout_seconds": 300
  },
  "cli": {
    "agents": {
      "claude": {
        "tool": "claude",
        "models": {
          "complex": "opus",
          "moderate": "sonnet",
          "simple": "haiku"
        }
      },
      "copilot": {
        "tool": "copilot",
        "models": {
          "complex": "claude-sonnet-4.6",
          "moderate": "claude-sonnet-4.6",
          "simple": "claude-haiku-4.5"
        }
      }
    }
  },
  "execution": {
    "max_attempts": 2,
    "halt_on_failure": true,
    "auto_commit": true,
    "commit_format": "task {task_id}: {title}"
  },
  "archival": {
    "auto_archive": true
  },
  "prompts": {
    "custom_instructions": "Follow Go conventions. Keep it simple. Test as you go."
  }
}
